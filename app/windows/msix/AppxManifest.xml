<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package. Identity values come from Partner Center
  (Product management > Product identity) and must match it exactly.
  pack.ps1 fills in the version from app/tauri.conf.json.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Applicant.KJVInterlinear"
    Publisher="CN=DB7E07FF-68DD-45B8-9CBD-005C16852BEA"
    Version="$VERSION$"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>KJV Interlinear</DisplayName>
    <PublisherDisplayName>Divhanthelion</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>The King James Bible with the Hebrew and Greek behind every verse.</Description>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809 or later; WebView2 ships with Windows 11 and current Windows 10 -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="KJVInterlinear" Executable="kjv-interlinear.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="KJV Interlinear"
        Description="The King James Bible with the Hebrew and Greek behind every verse."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <!-- The optional study assistant talks to the AI provider the reader sets up -->
    <Capability Name="internetClient" />
    <!-- A regular desktop app (Rust + WebView2) -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
